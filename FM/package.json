{
  "name": "flooring-junction-desktop",
  "version": "1.0.0",
  "description": "Desktop wrapper for the Flooring Junction app",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm --prefix frontend/Backened run dev\" \"npm --prefix frontend/frontend run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "start": "electron .",
    "build:frontend": "npm --prefix frontend/frontend run build",
    "dist": "npm run build:frontend && electron-builder"
  },
  "build": {
    "appId": "com.flooringjunction.desktop",
    "productName": "Flooring Junction",
    "directories": {
      "app": "."
    },
    "files": [
      "electron/**/*",
      "frontend/**/*",
      "!frontend/**/*.map",
      "!**/.git/**",
      "!**/.next/cache/**"
    ],
    "extraResources": [
      {
        "from": "frontend/Backened",
        "to": "app-backend"
      },
      {
        "from": "frontend/frontend/.next",
        "to": "app-frontend/.next"
      },
      {
        "from": "frontend/frontend/public",
        "to": "app-frontend/public"
      },
      {
        "from": "frontend/frontend/node_modules",
        "to": "app-frontend/node_modules"
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "frontend/frontend/app/favicon.ico",
      "artifactName": "Flooring-Junction-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "frontend/frontend/app/favicon.ico",
      "uninstallerIcon": "frontend/frontend/app/favicon.ico",
      "installerHeaderIcon": "frontend/frontend/app/favicon.ico"
    }
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "electron": "^38.0.0",
    "electron-builder": "^26.18.0",
    "wait-on": "^9.5.1"
  }
}
